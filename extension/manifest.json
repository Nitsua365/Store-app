{
  "manifest_version": 3,
  "name": "Americazon.shop",
  "description": "The mission is to give more consumer transparency about where products on Amazon are made.",
  "version": "0.0.4.1",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "America16.png",
    "64": "America64.png",
    "128": "America128.png"
  },
  "host_permissions": [
    "https://*.amazon.com/*"
  ],
  "permissions": [
    "scripting",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [ "America128.png" ],
      "matches": [ "https://*.amazon.com/*" ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}