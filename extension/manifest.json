{
  "manifest_version": 3,
  "name": "Americazon.shop",
  "description": "The mission is to give more consumer transparency about where products on Amazon are made.",
  "version": "0.0.1",
  "background": { 
    "service_worker": "dist/background.js"
  },
  "icons": {
    "16": "public/America16.png",
    "64": "public/America64.png",
    "128": "public/America128.png"
  },
  "host_permissions": [
    "https://www.amazon.com/s*",
    "https://www.amazon.com/b*"
  ],
  "permissions": [ 
    "scripting", 
    "tabs"
  ],
  "action": {
    "default_popup": "src/popup.html"
  }
}