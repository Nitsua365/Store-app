generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model amazon_department {
  name           String          @id @db.VarChar(255)
  subdepartments String?         @db.VarChar(255)
  departmentlink String?         @db.VarChar(500)
  scrapelink     String?         @db.VarChar(500)
  scrape_session scrape_session?
}

model amazon_products {
  asin            String   @id @db.VarChar(20)
  productname     String?  @db.VarChar(500)
  department      String?  @db.VarChar(100)
  manufacturer    String?  @db.VarChar(255)
  rating          Decimal? @db.Decimal(3, 2)
  picturereflink  String?  @db.VarChar(500)
  countryoforigin String?  @db.VarChar(60)
  datescrapped    DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  price           Decimal? @db.Decimal(10, 2)
  affiliatelink   String?  @db.VarChar(500)
  productpagelink String?  @db.VarChar(500)
}

model scrape_session {
  departmentname    String            @unique @db.VarChar(255)
  datelastscrapped  DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  pageleftoff       Int?
  amazon_department amazon_department @relation(fields: [departmentname], references: [name], onDelete: NoAction, onUpdate: NoAction)
}
